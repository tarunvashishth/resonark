# Copy to .env.local to swap in real AI engines. Without these, EchoRank
# runs entirely on simulated responses (src/lib/engines/mock.ts) so the app
# works out of the box with zero setup.

SESSION_SECRET=replace-with-a-random-string

# Each is independently optional — engines fall back to mock per-key.
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# Not wired into the app yet (data layer is still the local JSON store in
# src/lib/db.ts). See supabase/migrations/0001_init.sql for the schema to
# provision once you're ready to move off the mock store.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# RESEND_API_KEY=
